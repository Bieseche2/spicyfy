<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep"
    android:padding="26dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="22dp"
        android:background="@drawable/gradient_card_1" />

    <TextView
        android:id="@+id/np_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fogo Baixo"
        android:textColor="@color/text_hi"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/np_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nômade"
        android:textColor="@color/text_mid"
        android:textSize="13.5sp"
        android:layout_marginBottom="22dp" />

    <LinearLayout
        android:id="@+id/np_controls_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/np_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="@color/line"
            android:progress="38"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="22dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1:24"
                android:textColor="@color/text_low"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="3:41"
                android:textColor="@color/text_low"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="30dp">

            <ImageButton
                android:id="@+id/np_previous"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:contentDescription="@string/nav_now_playing"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/np_play_pause"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/artist_circle_bg"
                android:contentDescription="@string/nav_now_playing"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/np_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:contentDescription="@string/nav_now_playing"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/np_lyrics_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/np_lyrics_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/np_lyrics_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lyrics_show"
        android:textColor="@color/text_low"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="16dp"
        android:background="@null" />

</LinearLayout>
