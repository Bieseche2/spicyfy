<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep"
    android:padding="26dp">

    <ImageView
        android:id="@+id/np_cover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="22dp"
        android:scaleType="centerCrop"
        android:background="@drawable/gradient_card_1"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/np_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_hi"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/np_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_mid"
                android:textSize="13.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/np_add_playlist"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@null"
            android:contentDescription="@string/add_to_playlist"
            android:src="@drawable/ic_add" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="22dp" />

    <LinearLayout
        android:id="@+id/np_controls_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <SeekBar
            android:id="@+id/np_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="@color/line"
            android:thumbTint="@color/accent"
            android:layout_marginBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="22dp">

            <TextView
                android:id="@+id/np_time_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/text_low"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/np_time_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0:00"
                android:textColor="@color/text_low"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="30dp">

            <ImageButton
                android:id="@+id/np_previous"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:contentDescription="@string/nav_now_playing"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/np_play_pause"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/artist_circle_bg"
                android:contentDescription="@string/nav_now_playing"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/np_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:contentDescription="@string/nav_now_playing"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/np_lyrics_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/np_lyrics_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/np_lyrics_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lyrics_show"
        android:textColor="@color/text_low"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="16dp"
        android:background="@null" />

</LinearLayout>
