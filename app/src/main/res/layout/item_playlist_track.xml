<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="7dp">

    <TextView
        android:id="@+id/pt_number"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_low"
        android:textSize="12sp"
        tools:text="1" />

    <ImageView
        android:id="@+id/pt_cover"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="8dp"
        android:scaleType="centerCrop"
        android:background="@drawable/gradient_card_small"
        android:clipToOutline="true"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="11dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_hi"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Fogo Baixo" />

        <TextView
            android:id="@+id/pt_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_low"
            android:textSize="11.5sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Nômade" />
    </LinearLayout>
</LinearLayout>
